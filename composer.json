{
    "name": "tomaj/prepositioner",
    "description": "Preposition replace library for Slovak, Czech, and Romanian languages with HTML support",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "preposition",
        "prepositions",
        "slovak",
        "czech",
        "romanian",
        "grammar",
        "typography",
        "nbsp",
        "non-breaking-space",
        "text-formatting",
        "html"
    ],
    "authors": [
        {
            "name": "Tomas Majer",
            "email": "tomasmajer@gmail.com",
            "homepage": "http://www.tomaj.sk/"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0",
        "squizlabs/php_codesniffer": "^3.10",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0"
    },
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Tomaj\\Prepositioner\\": "src/Prepositioner/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tomaj\\Prepositioner\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs": "phpcs --standard=PSR12 src tests",
        "cs-fix": "phpcbf --standard=PSR12 src tests",
        "phpstan": "phpstan analyse -c phpstan.neon",
        "check": [
            "@cs",
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
