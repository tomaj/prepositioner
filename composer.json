{
    "name": "tomaj/prepositioner",
    "description": "Preposition replace library for Slovak, Czech, and Romanian languages with HTML support",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "preposition",
        "prepositions",
        "slovak",
        "czech",
        "romanian",
        "grammar",
        "typography",
        "nbsp",
        "non-breaking-space",
        "text-formatting",
        "html"
    ],
    "authors": [
        {
            "name": "Tomas Majer",
            "email": "tomasmajer@gmail.com",
            "homepage": "http://www.tomaj.sk/"
        }
    ],
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.90",
        "infection/infection": "^0.27|^0.28|^0.29",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "^11.5",
        "rector/rector": "^2.8"
    },
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Tomaj\\Prepositioner\\": "src/Prepositioner/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tomaj\\Prepositioner\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "@phpcs",
            "@phpstan",
            "@rector",
            "@test"
        ],
        "coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "phpunit --coverage-clover build/logs/clover.xml --coverage-html build/coverage"
        ],
        "cs-fix": "php-cs-fixer fix",
        "infection": [
            "@putenv XDEBUG_MODE=coverage",
            "infection --threads=max"
        ],
        "phpcs": "php-cs-fixer fix --dry-run --diff --verbose",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "phpunit": [
            "@putenv XDEBUG_MODE=off",
            "phpunit --no-coverage"
        ],
        "rector": "rector --dry-run",
        "rector-fix": "rector",
        "test": "@phpunit"
    },
    "scripts-descriptions": {
        "check": "Runs code style, PHPStan, Rector and the tests.",
        "coverage": "Runs the tests with Xdebug coverage (Clover in build/logs, HTML in build/coverage).",
        "cs-fix": "Fixes the code style with PHP-CS-Fixer.",
        "infection": "Runs Infection mutation testing (thresholds in infection.json5).",
        "phpcs": "Checks the code style with PHP-CS-Fixer (dry run).",
        "phpstan": "Runs PHPStan static analysis.",
        "phpunit": "Runs the PHPUnit tests without coverage.",
        "rector": "Shows the changes Rector would make (dry run).",
        "rector-fix": "Applies Rector changes.",
        "test": "Runs the PHPUnit tests."
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        },
        "sort-packages": true
    },
    "support": {
        "issues": "https://github.com/tomaj/prepositioner/issues",
        "source": "https://github.com/tomaj/prepositioner",
        "security": "https://github.com/tomaj/prepositioner/security/policy"
    },
    "archive": {
        "exclude": [
            "/tests",
            "/.github",
            "/phpstan.neon",
            "/phpunit.xml",
            "/infection.json5",
            "/.gitattributes",
            "/.gitignore",
            "/CONTRIBUTING.md",
            "/CODE_OF_CONDUCT.md"
        ]
    }
}
