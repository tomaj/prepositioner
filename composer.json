{
    "name": "tomaj/prepositioner",
    "description": "Preposition replace library for Slovak, Czech, and Romanian languages with HTML support",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "preposition",
        "prepositions",
        "slovak",
        "czech",
        "romanian",
        "grammar",
        "typography",
        "nbsp",
        "non-breaking-space",
        "text-formatting",
        "html"
    ],
    "authors": [
        {
            "name": "Tomas Majer",
            "email": "tomasmajer@gmail.com",
            "homepage": "http://www.tomaj.sk/"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "infection/infection": "^0.27|^0.28|^0.29",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^10.0|^11.0",
        "squizlabs/php_codesniffer": "^3.10 || ^4.0"
    },
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Tomaj\\Prepositioner\\": "src/Prepositioner/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tomaj\\Prepositioner\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs": "phpcs --standard=PSR12 src tests",
        "cs-fix": "phpcbf --standard=PSR12 src tests",
        "phpstan": "phpstan analyse -c phpstan.neon",
        "infection": "infection --show-mutations --min-msi=95 --min-covered-msi=95",
        "check": [
            "@cs",
            "@phpstan",
            "@test"
        ],
        "check-all": [
            "@check",
            "@infection"
        ]
    },
    "scripts-descriptions": {
        "test": "Run PHPUnit tests",
        "cs": "Check code style (PSR-12)",
        "cs-fix": "Fix code style issues",
        "phpstan": "Run static analysis",
        "infection": "Run mutation testing",
        "check": "Run all checks (code style, static analysis, tests)",
        "check-all": "Run all checks including mutation testing"
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        },
        "sort-packages": true
    },
    "support": {
        "issues": "https://github.com/tomaj/prepositioner/issues",
        "source": "https://github.com/tomaj/prepositioner",
        "security": "https://github.com/tomaj/prepositioner/security/policy"
    },
    "archive": {
        "exclude": [
            "/tests",
            "/.github",
            "/phpstan.neon",
            "/phpunit.xml",
            "/infection.json5",
            "/.gitattributes",
            "/.gitignore",
            "/CONTRIBUTING.md",
            "/CODE_OF_CONDUCT.md"
        ]
    }
}
